# 이 파일을 .env.real로 복사하고 키를 입력하세요. 채팅이나 Git에 키를 올리지 않습니다.
# 기존 .env.real이 있으면 덮어쓰지 않습니다. 현재 값은 백엔드 단독 실행의 기본 포트입니다.
# start-phase5-local.ps1 -Mode Real은 화면5195·백엔드18095·DB13395를 명시적으로 사용합니다.
SPRING_PROFILES_ACTIVE=real
APP_DATA_MODE=REAL
MYSQL_DATABASE=stock_insight_real
MYSQL_USER=stock_insight
MYSQL_PASSWORD=local_real_password
MYSQL_ROOT_PASSWORD=local_real_root_password
MYSQL_PORT=13307
SERVER_PORT=8081
DART_API_KEY=
# 금융위원회_주식시세정보 활용 승인 후 공공데이터포털의 Decoding 키를 입력합니다.
# 비워 두면 종가를 저장하지 않으며 재무제표 기반 지표만 제공합니다.
FSC_API_KEY=
