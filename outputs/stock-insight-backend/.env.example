# 백엔드 단독 run-local.ps1 / Docker Compose용 예시입니다. 외부 키 없는 MOCK 모드입니다.
# 화면까지 켜는 start-phase5-local.ps1 -Mode Mock은 별도 포트·전용 DB를 자동 사용합니다.
MYSQL_DATABASE=stock_insight_mock
MYSQL_USER=stock_insight
MYSQL_PASSWORD=local_mock_password
MYSQL_ROOT_PASSWORD=local_root_password
MYSQL_PORT=13306
SERVER_PORT=8080
# REAL은 .env.real.example을 참고합니다. DART는 발급 원문, FSC는 Decoding 키 원문입니다.
SPRING_PROFILES_ACTIVE=mock
APP_DATA_MODE=MOCK
DART_API_KEY=
FSC_API_KEY=
